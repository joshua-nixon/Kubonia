<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kubonia.Client.Controls.PageLayout"
             x:Name="Root">
    <Grid RowDefinitions="Auto,*">
        <Grid Margin="22,22,22,0"
              ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding Description, ElementName=Root}"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <ContentControl Grid.Column="1"
                            Content="{Binding HeaderActions, ElementName=Root}"
                            VerticalAlignment="Center" />
        </Grid>

        <ContentControl Grid.Row="1"
                        Margin="22,0,22,22"
                        Content="{Binding Body, ElementName=Root}" />
    </Grid>
</UserControl>
