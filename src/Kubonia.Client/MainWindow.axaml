<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="using:Kubonia.Client.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="Kubonia.Client.MainWindow"
        Title="Kubonia"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        TransparencyLevelHint="Mica"
        CanResize="True">

    <Grid ColumnDefinitions="224,*">
        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Context -->
                <Border DockPanel.Dock="Top"
                        Margin="12,10,12,6"
                        Height="48"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1"
                        Padding="10,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="CONTEXT"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="docker-desktop"
                                       Margin="0,4,0,0"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text=">"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                    </Grid>
                </Border>

                <!-- Navigation -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,16" Spacing="1">

                        <Button Classes="SidebarGroupToggle"
                                Click="NavigationGroupToggle_Click">
                            <Grid ColumnDefinitions="Auto,*">
                                <Path x:Name="WorkloadsChevron"
                                      Width="10"
                                      Height="6"
                                      Stretch="Fill"
                                      RenderTransformOrigin="50%,50%"
                                      Data="M 1,1 L 5,5 L 9,1"
                                      Stroke="{DynamicResource TextMuted}"
                                      StrokeThickness="1.5" />
                                <TextBlock x:Name="WorkloadsTitle"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Grid>
                        </Button>

                        <ListBox x:Name="WorkloadsItems"
                                 Classes="NavigationGroupItems"
                                 Margin="4,3,0,0"
                                 IsVisible="True"
                                 SelectionChanged="NavigationPages_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="navigation:NavigationViewDefinition">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource Accent}" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" RowDefinitions="44,*">
            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,0,1"
                    Padding="10,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Classes="ToolbarButton">
                            <TextBlock Text="&lt;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Classes="ToolbarButton">
                            <TextBlock Text="&gt;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            Height="30"
                            Padding="10,0"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceElevated}"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" />
                            <TextBlock Text="Connected"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TabControl x:Name="PageTabs"
                        Grid.Row="1"
                        Classes="WorkspaceTabs"
                        SelectionChanged="PageTabs_SelectionChanged">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="navigation:WorkspaceTab">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center" />
                            <Button Classes="WorkspaceTabClose"
                                    Content="×"
                                    ToolTip.Tip="Close tab"
                                    Click="CloseTab_Click" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="navigation:WorkspaceTab">
                        <ContentControl Content="{Binding Content}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
</Window>
