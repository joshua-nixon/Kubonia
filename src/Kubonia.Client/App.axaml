<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             x:Class="Kubonia.Client.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Light"
                              PrimaryColor="DeepOrange"
                              SecondaryColor="Blue" />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Inter, Helvetica Neue, Arial, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TabControl.WorkspaceTabs">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <Style Selector="TabControl.WorkspaceTabs /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
        </Style>

        <Style Selector="TabControl.WorkspaceTabs TabItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="5,4,2,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TabControl.WorkspaceTabs TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TabControl.WorkspaceTabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TabControl.WorkspaceTabs TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        </Style>

        <Style Selector="TabControl.WorkspaceTabs TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Button.WorkspaceTabClose">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.WorkspaceTabClose:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Border.NavItem">
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.NavItem.Selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>

        <Style Selector="Border.NavItem.Selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.NavItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.NavItem TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="ListBox.NavigationGroupItems">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.NavigationGroupItems ListBoxItem">
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ListBox.NavigationGroupItems ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="ListBox.NavigationGroupItems ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>

        <Style Selector="ListBox.NavigationGroupItems ListBoxItem TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="ListBox.NavigationGroupItems ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.SidebarGroupToggle">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Button.SidebarGroupToggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Button.SidebarGroupToggle:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.ToolbarButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.ToolbarButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.ToolbarButton TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Border.MetricCard">
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.TableHeader">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style Selector="Grid.TableRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Grid.TableRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="TextBlock.TableCell">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="TextBlock.TableCellName">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.TableStatusSuccess">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Success}" />
        </Style>

        <Style Selector="TextBlock.TableStatusWarning">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        </Style>

        <Style Selector="TextBlock.TableStatusDanger">
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>

        <Style Selector="DataGrid.SortableTable">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderDefault}" />
        </Style>

        <Style Selector="DataGrid.SortableTable DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style Selector="DataGrid.SortableTable DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style Selector="DataGrid.SortableTable DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Button.ActionButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ActionOrange}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionOrange}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.ActionButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ActionOrangeHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionOrangeHover}" />
        </Style>

        <Style Selector="Button.ActionButton:pressed">
            <Setter Property="Background" Value="{DynamicResource ActionOrangePressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionOrangePressed}" />
        </Style>

    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceElevated" Color="#F4F6F8" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#EDF1F5" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#F7F8FA" />
        <SolidColorBrush x:Key="BorderDefault" Color="#DDE2E8" />
        <SolidColorBrush x:Key="BorderStrong" Color="#C9D1DB" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1C2735" />
        <SolidColorBrush x:Key="TextSecondary" Color="#536174" />
        <SolidColorBrush x:Key="TextMuted" Color="#7A8797" />
        <SolidColorBrush x:Key="ActionOrange" Color="#E87924" />
        <SolidColorBrush x:Key="ActionOrangeHover" Color="#D96A17" />
        <SolidColorBrush x:Key="ActionOrangePressed" Color="#BE5A11" />
        <SolidColorBrush x:Key="Accent" Color="#E64A19" />
        <SolidColorBrush x:Key="AccentSoft" Color="#FBE9E7" />
        <SolidColorBrush x:Key="AccentStrong" Color="#BF360C" />
        <SolidColorBrush x:Key="Link" Color="#315FCC" />
        <SolidColorBrush x:Key="Success" Color="#2E944F" />
        <SolidColorBrush x:Key="Warning" Color="#B78310" />
        <SolidColorBrush x:Key="Danger" Color="#D94B45" />
        <SolidColorBrush x:Key="Purple" Color="#8C5BE2" />
    </Application.Resources>
</Application>