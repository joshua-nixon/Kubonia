<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="Kubonia.Client.MainWindow"
        Title="Kubonia"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        TransparencyLevelHint="Mica"
        CanResize="True">

    <Grid ColumnDefinitions="248,*">
        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <Border DockPanel.Dock="Top"
                        Height="72"
                        Padding="16,0"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="8"
                                Background="#34343A"
                                BorderBrush="#45454D"
                                BorderThickness="1">
                            <TextBlock Text="K"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </Border>
                        <TextBlock Text="kubonia"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <Border Margin="6,0,0,0"
                                Padding="6,2"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1">
                            <TextBlock Text="DEV"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMuted}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Context -->
                <Border DockPanel.Dock="Top"
                        Margin="12,12,12,8"
                        Height="54"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1"
                        Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="CONTEXT"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="docker-desktop"
                                       Margin="0,4,0,0"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text=">"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                    </Grid>
                </Border>

                <!-- Navigation -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,6,8,16" Spacing="2">
                        <TextBlock Text="OVERVIEW"
                                   Margin="10,10,10,5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" />

                        <Border Height="38" CornerRadius="7" Background="{DynamicResource SurfaceHover}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" />
                                <TextBlock Text="Overview"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WORKLOADS"
                                   Margin="10,16,10,5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" />

                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Link}" />
                                <TextBlock Text="Pods" />
                            </StackPanel>
                        </Border>
                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Purple}" />
                                <TextBlock Text="Deployments" />
                            </StackPanel>
                        </Border>
                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" />
                                <TextBlock Text="StatefulSets" />
                            </StackPanel>
                        </Border>
                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Warning}" />
                                <TextBlock Text="DaemonSets" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="NETWORK"
                                   Margin="10,16,10,5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" />

                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" />
                                <TextBlock Text="Services" />
                            </StackPanel>
                        </Border>
                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Link}" />
                                <TextBlock Text="Ingress" />
                            </StackPanel>
                        </Border>
                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Warning}" />
                                <TextBlock Text="Network Policies" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="CLUSTER"
                                   Margin="10,16,10,5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" />

                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Nodes" />
                            </StackPanel>
                        </Border>
                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Namespaces" />
                            </StackPanel>
                        </Border>
                        <Border Classes="NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}" />
                                <TextBlock Text="Events" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" RowDefinitions="44,*">
            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,0,1"
                    Padding="10,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Classes="ToolbarButton">
                            <TextBlock Text="&lt;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Classes="ToolbarButton">
                            <TextBlock Text="&gt;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            Height="30"
                            Padding="10,0"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceElevated}"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" />
                            <TextBlock Text="Connected"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Dashboard -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" Spacing="20">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Overview"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Cluster resources and health"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Height="34"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                CornerRadius="7"
                                Background="{DynamicResource AccentStrong}"
                                BorderBrush="{DynamicResource AccentStrong}"
                                BorderThickness="1">
                            <TextBlock Text="Refresh"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </Grid>

                    <!-- Summary cards -->
                    <UniformGrid Columns="4">
                        <Border Classes="MetricCard">
                            <StackPanel>
                                <TextBlock Text="Nodes" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="3"
                                           Margin="0,8,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="All ready"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Success}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="MetricCard">
                            <StackPanel>
                                <TextBlock Text="Pods" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="42"
                                           Margin="0,8,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="38 running"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Success}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="MetricCard">
                            <StackPanel>
                                <TextBlock Text="Deployments" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="12"
                                           Margin="0,8,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="11 healthy"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Success}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="MetricCard">
                            <StackPanel>
                                <TextBlock Text="Warnings" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="4"
                                           Margin="0,8,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Needs attention"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Warning}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Resource table -->
                    <Border CornerRadius="9"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Height="54"
                                    Padding="16,0"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Recent resources"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Grid.Column="1"
                                            Width="220"
                                            Height="32"
                                            CornerRadius="7"
                                            Background="{DynamicResource AppBackground}"
                                            BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="1"
                                            Padding="10,0">
                                        <TextBlock Text="Search resources"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid RowDefinitions="36,42,42,42,42,42">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="2*,1.2*,1*,1*,0.7*"
                                      Background="{DynamicResource SurfaceElevated}">
                                    <TextBlock Classes="TableHeader" Text="NAME" />
                                    <TextBlock Grid.Column="1" Classes="TableHeader" Text="NAMESPACE" />
                                    <TextBlock Grid.Column="2" Classes="TableHeader" Text="STATUS" />
                                    <TextBlock Grid.Column="3" Classes="TableHeader" Text="TYPE" />
                                    <TextBlock Grid.Column="4" Classes="TableHeader" Text="AGE" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="2*,1.2*,1*,1*,0.7*" Classes="TableRow">
                                    <TextBlock Classes="TableCellName" Text="api-deployment-7d5c8" />
                                    <TextBlock Grid.Column="1" Classes="TableCell" Text="production" />
                                    <TextBlock Grid.Column="2" Classes="TableStatusSuccess" Text="Running" />
                                    <TextBlock Grid.Column="3" Classes="TableCell" Text="Deployment" />
                                    <TextBlock Grid.Column="4" Classes="TableCell" Text="3h" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="2*,1.2*,1*,1*,0.7*" Classes="TableRow">
                                    <TextBlock Classes="TableCellName" Text="postgres-0" />
                                    <TextBlock Grid.Column="1" Classes="TableCell" Text="databases" />
                                    <TextBlock Grid.Column="2" Classes="TableStatusSuccess" Text="Running" />
                                    <TextBlock Grid.Column="3" Classes="TableCell" Text="Pod" />
                                    <TextBlock Grid.Column="4" Classes="TableCell" Text="2d" />
                                </Grid>
                                <Grid Grid.Row="3" ColumnDefinitions="2*,1.2*,1*,1*,0.7*" Classes="TableRow">
                                    <TextBlock Classes="TableCellName" Text="frontend-ingress" />
                                    <TextBlock Grid.Column="1" Classes="TableCell" Text="production" />
                                    <TextBlock Grid.Column="2" Classes="TableStatusWarning" Text="Pending" />
                                    <TextBlock Grid.Column="3" Classes="TableCell" Text="Ingress" />
                                    <TextBlock Grid.Column="4" Classes="TableCell" Text="18m" />
                                </Grid>
                                <Grid Grid.Row="4" ColumnDefinitions="2*,1.2*,1*,1*,0.7*" Classes="TableRow">
                                    <TextBlock Classes="TableCellName" Text="worker-daemon" />
                                    <TextBlock Grid.Column="1" Classes="TableCell" Text="kube-system" />
                                    <TextBlock Grid.Column="2" Classes="TableStatusSuccess" Text="Ready" />
                                    <TextBlock Grid.Column="3" Classes="TableCell" Text="DaemonSet" />
                                    <TextBlock Grid.Column="4" Classes="TableCell" Text="6d" />
                                </Grid>
                                <Grid Grid.Row="5" ColumnDefinitions="2*,1.2*,1*,1*,0.7*" Classes="TableRow">
                                    <TextBlock Classes="TableCellName" Text="metrics-server" />
                                    <TextBlock Grid.Column="1" Classes="TableCell" Text="kube-system" />
                                    <TextBlock Grid.Column="2" Classes="TableStatusDanger" Text="Failed" />
                                    <TextBlock Grid.Column="3" Classes="TableCell" Text="Pod" />
                                    <TextBlock Grid.Column="4" Classes="TableCell" Text="42m" />
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
