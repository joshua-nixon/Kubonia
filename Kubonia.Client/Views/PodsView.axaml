<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kubonia.Client.Views"
             x:Class="Kubonia.Client.Views.PodsView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                    <TextBlock Text="Pods"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Pods in the current cluster"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
                <TextBlock x:Name="PodCountText"
                           Grid.Column="1"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Classes="PodsRefreshButton"
                        Click="RefreshButton_Click">
                    <TextBlock Text="Refresh"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White" />
                </Button>
            </Grid>

            <TextBlock x:Name="LoadingText"
                       Text="Loading pods..."
                       IsVisible="False"
                       Foreground="{DynamicResource TextMuted}" />
            <TextBlock x:Name="EmptyText"
                       Text="No pods found."
                       IsVisible="False"
                       Foreground="{DynamicResource TextMuted}" />
            <TextBlock x:Name="ErrorText"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Danger}" />

            <Border x:Name="PodsTable"
                    IsVisible="False"
                    CornerRadius="9"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Height="38"
                            Background="{DynamicResource SurfaceElevated}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="2.2*,1.2*,0.9*,1.1*,1.1*,0.7*,0.7*,0.7*">
                            <TextBlock Classes="PodsTableHeader" Text="NAME" />
                            <TextBlock Grid.Column="1" Classes="PodsTableHeader" Text="NAMESPACE" />
                            <TextBlock Grid.Column="2" Classes="PodsTableHeader" Text="STATUS" />
                            <TextBlock Grid.Column="3" Classes="PodsTableHeader" Text="NODE" />
                            <TextBlock Grid.Column="4" Classes="PodsTableHeader" Text="POD IP" />
                            <TextBlock Grid.Column="5" Classes="PodsTableHeader" Text="READY" />
                            <TextBlock Grid.Column="6" Classes="PodsTableHeader" Text="RESTARTS" />
                            <TextBlock Grid.Column="7" Classes="PodsTableHeader" Text="AGE" />
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="PodsRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:PodRowViewModel">
                                <Grid Classes="PodsTableRow"
                                      ColumnDefinitions="2.2*,1.2*,0.9*,1.1*,1.1*,0.7*,0.7*,0.7*">
                                    <TextBlock Classes="PodsTableName" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="PodsTableCell" Text="{Binding Namespace}" />
                                    <TextBlock Grid.Column="2" Classes="PodsTableCell" Text="{Binding Phase}" />
                                    <TextBlock Grid.Column="3" Classes="PodsTableCell" Text="{Binding NodeName}" />
                                    <TextBlock Grid.Column="4" Classes="PodsTableCell" Text="{Binding PodIp}" />
                                    <TextBlock Grid.Column="5" Classes="PodsTableCell" Text="{Binding Ready}" />
                                    <TextBlock Grid.Column="6" Classes="PodsTableCell" Text="{Binding RestartCount}" />
                                    <TextBlock Grid.Column="7" Classes="PodsTableCell" Text="{Binding Age}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
